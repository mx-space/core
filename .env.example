# THIS ENV FILE EXAMPLE ONLY FOR DOCKER COMPOSE
# SEE https://docs.docker.com/compose/environment-variables/#the-env-file
# Set a private instance secret (at least 32 characters for V2). Preserve an existing value.
JWT_SECRET=
ALLOWED_ORIGINS=innei.ren,www.innei.ren

# Must be 64 hexadecimal characters. Keep the existing key when upgrading.
ENCRYPT_KEY=
# Temporary legacy plaintext escape hatch; v18 will require encryption.
ENCRYPT_ENABLE=false

# Comma-separated HTTPS origins that mx-core may contact for Push Relay.
MX_PUSH_RELAY_ORIGINS=

# CDN Cache header
CDN_CACHE_HEADER=true
FORCE_CACHE_HEADER=false

# PostgreSQL
PG_URL=

# Throttle
THROTTLE_TTL=10
THROTTLE_LIMIT=20

# Enable only after every replica has the compatible secret reader; see docs/security-secret-storage.md
MX_SECRET_STORAGE_V2=false
