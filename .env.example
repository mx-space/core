# THIS ENV FILE EXAMPLE ONLY FOR DOCKER COMPOSE
# SEE https://docs.docker.com/compose/environment-variables/#the-env-file
# Required: a private JWT secret of at least 32 characters. Preserve an existing value.
JWT_SECRET=
ALLOWED_ORIGINS=innei.ren,www.innei.ren

# Required: 64 hexadecimal characters. Keep the existing key when upgrading.
# New instances only: openssl rand -hex 32; persist this value before starting.
ENCRYPT_KEY=

# Comma-separated HTTPS origins that mx-core may contact for Push Relay.
MX_PUSH_RELAY_ORIGINS=

# CDN Cache header
CDN_CACHE_HEADER=true
FORCE_CACHE_HEADER=false

# PostgreSQL
PG_URL=

# Throttle
THROTTLE_TTL=10
THROTTLE_LIMIT=20
