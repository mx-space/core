# Local-only Push Relay env (gitignored). Copy and fill before:
#   pnpm --filter @mx-space/push-relay start:1p
#
# APNs .p8 is NOT stored here — it is loaded from 1Password:
#   op://Apple Developer/Yohaku APNs Sandbox

PUSH_RELAY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/push_relay
# 32-byte key as 64 hex chars, or base64. Generate: openssl rand -hex 32
PUSH_RELAY_DATA_KEY=
PUSH_RELAY_PORT=8787
PUSH_RELAY_PUBLIC_URL=http://127.0.0.1:8787
