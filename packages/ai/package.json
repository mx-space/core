{
  "name": "@mx-space/ai",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared AI building blocks for mx-space: SSE contracts, language codes, model runtime, prompts and translation engine",
  "license": "MIT",
  "author": "Innei <https://innei.in>",
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts"
    },
    "./decision": {
      "types": "./src/decision/index.ts",
      "import": "./src/decision/index.ts"
    },
    "./engine": {
      "types": "./src/engine/index.ts",
      "import": "./src/engine/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "import": "./src/prompts/index.ts"
    },
    "./translation": {
      "types": "./src/translation/index.ts",
      "import": "./src/translation/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js"
      },
      "./decision": {
        "types": "./dist/decision/index.d.ts",
        "import": "./dist/decision/index.js"
      },
      "./engine": {
        "types": "./dist/engine/index.d.ts",
        "import": "./dist/engine/index.js"
      },
      "./prompts": {
        "types": "./dist/prompts/index.d.ts",
        "import": "./dist/prompts/index.js"
      },
      "./translation": {
        "types": "./dist/translation/index.d.ts",
        "import": "./dist/translation/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "bump": {
    "before": [
      "git pull --rebase",
      "pnpm i",
      "npm run build"
    ],
    "after": [
      "npm publish --access=public"
    ],
    "tag": false,
    "commit_message": "chore(release): bump @mx-space/ai to v${NEW_VERSION}"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@haklex/rich-headless": "0.52.0",
    "@innei/message-engine": "0.5.0",
    "es-toolkit": "^1.52.0",
    "json5": "2.2.3",
    "jsonrepair": "^3.15.0",
    "typebox": "1.3.35",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
