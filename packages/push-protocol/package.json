{
  "name": "@mx-space/push-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned, privacy-preserving protocol shared by mx-core and Push Relay",
  "license": "AGPLv3",
  "author": "Innei <https://innei.in>",
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsrs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsdown": "0.23.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "5.0.5"
  }
}
