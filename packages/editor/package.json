{
  "name": "@mx-space/editor",
  "version": "0.5.1",
  "type": "module",
  "description": "Mx-space business editor contracts and projection utilities built on Lexical",
  "license": "MIT",
  "author": "Innei <https://innei.in>",
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./loro": {
      "types": "./src/loro/index.ts",
      "import": "./src/loro/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      },
      "./loro": {
        "types": "./dist/loro/index.d.ts",
        "import": "./dist/loro/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "bump": {
    "before": [
      "git pull --rebase",
      "pnpm i",
      "npm run build"
    ],
    "after": [
      "npm publish --access=public"
    ],
    "tag": false,
    "commit_message": "chore(release): bump @mx-space/editor to v${NEW_VERSION}"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@haklex/rich-headless": "0.58.0",
    "@haklex/rich-litexml": "0.58.0",
    "@lexical/headless": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@noble/hashes": "2.4.0",
    "lexical": "^0.52.0"
  },
  "devDependencies": {
    "@haklex/rich-collab-loro": "0.58.0",
    "loro-crdt": "^1.16.4",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@haklex/rich-collab-loro": "0.58.0",
    "loro-crdt": "^1.16.4"
  },
  "peerDependenciesMeta": {
    "@haklex/rich-collab-loro": {
      "optional": true
    },
    "loro-crdt": {
      "optional": true
    }
  }
}
